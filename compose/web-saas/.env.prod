# web-saas PROD 镜像版本。CD 会在生产 release tag 部署时更新受管镜像。
# 这里只放镜像引用与非敏感运行参数；口令、token、数据库连接密钥由
# Ansible 从 Vault 渲染到主机的 /etc/xcontrol/web-saas/secrets.env，禁止入库。
# 每个镜像必须固定到不可变 tag 或 digest，禁止使用 latest。
ACCOUNTS_IMAGE=ghcr.io/ai-workspace-services/accounts:v2026.09.02-r7
BILLING_IMAGE=ghcr.io/ai-workspace-services/billing-service:v2026.09.02-r7
CONSOLE_IMAGE=ghcr.io/ai-workspace-services/console:v2026.09.02-r7

# bridge 暂不由跨仓快照 tag 管理；其流水线使用 commit SHA 镜像 tag。
XWORKMATE_BRIDGE_IMAGE=ghcr.io/ai-workspace-lab/xworkmate-bridge:050977839b464870b0ba1b6d294046b601b8958c

# 基础设施镜像单独固定，应用发布不应隐式升级它们。
CADDY_IMAGE=ghcr.io/ai-workspace-infra/caddy-cloudflare:959d6c8
POSTGRESQL_IMAGE=ghcr.io/ai-workspace-infra/postgresql:sha-7759f4513e1710e86332795b611507bbed37ea39
STUNNEL_SERVER_IMAGE=ghcr.io/ai-workspace-infra/stunnel-server:sha-7759f4513e1710e86332795b611507bbed37ea39
STUNNEL_CLIENT_IMAGE=ghcr.io/ai-workspace-infra/stunnel-client:sha-7759f4513e1710e86332795b611507bbed37ea39

DEPLOY_ENV=prod
ACCOUNT_SERVICE_URL=http://accounts:8080
NEXT_PUBLIC_ACCOUNT_SERVICE_URL=https://accounts.svc.plus
XWORKMATE_SHARED_TENANT_DOMAINS=svc.plus
XWORKMATE_SHARED_TENANT_DOMAIN=svc.plus
OTEL_TRACES_SAMPLER_ARG=0.05
POSTGRES_LOCAL_PORT=5432
STUNNEL_SERVER_PORT=15433
