{
  "apiVersion": "gitops.svc.plus/v1alpha1",
  "kind": "XConnectTransportLabTopology",
  "metadata": {"name": "xconnect-transport-lab", "environment": "uat"},
  "spec": {
    "iac_module": "vpn-overlay/xconnect-lab",
    "purpose": "validate-four-node-wireguard-over-vless-before-zero-enrollment",
    "ttl_minutes": 60,
    "compute_policy": "all-cloud-compute-is-aws-spot-by-default",
    "created_resource_scope": ["gateway-spot-instance", "linux-one-spot-instance", "ephemeral-security-groups"],
    "transport": {
      "protocol": "wireguard-over-vless-xhttp",
      "gateway_tls_port": 443,
      "xhttp_path": "/xconnect",
      "xhttp_mode": "auto",
      "xhttp_host": "tw-xconnect.svc.plus",
      "gateway_wireguard_port": 51820,
      "one_loopback_endpoint": "127.0.0.1:51830",
      "public_wireguard_ingress": false,
      "private_cidr": "10.77.0.0/24",
      "addresses": {"gateway": "10.77.0.1/24", "linux_one": "10.77.0.2/24", "windows_one": "10.77.0.3/24", "macos_one": "10.77.0.4/24"}
    },
    "nodes": {
      "gateway": {"role": "relay", "platform": "linux", "instance_type": "t4g.small", "purchase_model": "spot", "roles": ["xray/hub", "wireguard/hub"]},
      "linux_one": {"role": "controlled-client", "platform": "linux", "instance_type": "t4g.micro", "purchase_model": "spot", "roles": ["xray/tproxy", "wireguard/site"]},
      "windows_one": {"role": "controlled-client", "platform": "windows", "execution": "operator-authorized-lan-host", "roles": ["xray/tproxy", "wireguard/site"]},
      "windows_one_spot": {"role": "controlled-client", "platform": "windows", "execution": "future-opt-in-cloud-regression", "enabled": false, "instance_type": "t3a.medium", "purchase_model": "spot", "roles": ["xray/tproxy", "wireguard/site"]},
      "macos_one": {"role": "controlled-client", "platform": "darwin", "execution": "operator-authorized-local-or-self-hosted-runner", "roles": ["xray/tproxy", "wireguard/site"]}
    },
    "verification": {"require_exact_peer_handshake": true, "require_one_to_gateway_ping_http": true, "require_joined_one_to_one_ping_http": true, "http_marker": "per-run-random", "macos_opt_in": true},
    "aws": {"region": "ap-northeast-1", "reuse_default_vpc": true, "reuse_default_subnet": true, "role_arn": "arn:aws:iam::950604983695:role/GithubAction_IAC_Deploy_Role", "account_id": "950604983695"}
  }
}
